# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets — NEVER commit real values, never expose to the client.
# Used only in server routes: bootstrapping the first system admin and
# creating stage/stage-admin accounts (Supabase Admin API).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# One-time secret used by /admin/system/setup to create the first system
# admin account. Set this in your deployment env, rotate/remove it after use.
SYSTEM_ADMIN_SETUP_CODE=change-me
